  "description": "now-playing Lambda metrics pushed into Pushgateway and scraped by Prometheus.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "code": { "language": "markdown", "showLineNumbers": false, "showMiniMap": false },
        "content": "API invocation telemetry for `now-playing`. The Lambda emits `lho_lambda_invocations_total`, `lho_lambda_invocation_duration_seconds`, and `lho_lambda_last_invocation_timestamp_seconds` into Pushgateway.",
        "mode": "markdown"
      },
      "title": "Scope",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "noValue": "0", "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 3 },
      "id": 2,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(lho_lambda_invocations_total{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "API invocations / second",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "max": 100,
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 3 },
      "id": 3,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(lho_lambda_invocations_total{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\",outcome!=\"success\"}[5m])) / clamp_min(sum(rate(lho_lambda_invocations_total{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\"}[5m])), 0.0001)",
          "refId": "A"
        }
      ],
      "title": "API non-success rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 3,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 3 },
      "id": 4,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(lho_lambda_invocation_duration_seconds{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\"})",
          "refId": "A"
        }
      ],
      "title": "Latest API duration",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0, "noValue": "0", "unit": "dateTimeAsIso" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 3 },
      "id": 5,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1000 * max(lho_lambda_last_invocation_timestamp_seconds{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\"})",
          "refId": "A"
        }
      ],
      "title": "Last API invocation",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route, method, status) (rate(lho_lambda_invocations_total{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\",route=~\"/api/(health|version)\"}[5m]))",
          "legendFormat": "{{method}} {{route}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Health and version requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route, outcome) (rate(lho_lambda_invocations_total{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\"}[5m]))",
          "legendFormat": "{{route}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "API invocations by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (route) (lho_lambda_invocation_duration_seconds{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\"})",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "Latest duration by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (environment, function, version, git_sha) (lho_lambda_last_invocation_timestamp_seconds{service=\"now-playing\",operation=\"api\",environment=~\"$environment\",function=~\"$function\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Current build metadata",
      "type": "table"
