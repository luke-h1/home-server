# Copy to kubernetes/.env (gitignored): cp kubernetes/.env.example kubernetes/.env
# Used by scripts/k8s.sh and scripts/cloudflare-tunnel.sh

export KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"

# --- Public hostnames (Ingress + Grafana) ---
export DOCUMENT_DOMAIN="documents.lhowsam.com"
export N8N_DOMAIN="n8n.lhowsam.com"
export GRAFANA_DOMAIN="grafana.example.com"
export GRAFANA_ROOT_URL="https://grafana.example.com"
export PROMETHEUS_DOMAIN="prometheus.example.com"
export ALERTS_DOMAIN="alerts.example.com"
export PUSHGATEWAY_DOMAIN="pushgateway.example.com"
export UPTIME_LHOWSAM_DOMAIN="uptime.lhowsam.com"
export UPTIME_FOAM_DOMAIN="uptime.foam-app.com"

export GRAFANA_ADMIN_USER="admin"
export GRAFANA_ADMIN_PASSWORD="generate-a-strong-password"
export PUSHGATEWAY_BASIC_AUTH_USER="foam-proxy"
export PUSHGATEWAY_BASIC_AUTH_PASSWORD="generate-a-pushgateway-password"

# Traefik basic auth: Alertmanager (ALERTS_DOMAIN) + Prometheus (PROMETHEUS_DOMAIN). scripts/k8s.sh secrets -> alertmanager-basic-auth, prometheus-basic-auth
export ALERTS_BASIC_AUTH_USER="alerts-admin"
export ALERTS_BASIC_AUTH_PASSWORD="generate-a-different-strong-password"

# Pushgateway ingress for apps like foam-proxy. scripts/k8s.sh secrets -> pushgateway-basic-auth.
# Set app PUSHGATEWAY_URL to: https://${PUSHGATEWAY_DOMAIN}
# Set app PUSHGATEWAY_AUTH_HEADER to: Authorization=Basic <base64(username:password)>

# Alertmanager -> Telegram notifications (scripts/k8s.sh secrets -> alertmanager-telegram secret in monitoring)
# Create a bot with @BotFather, add it to your chat/channel, then set the bot token and numeric chat ID here.
export ALERTMANAGER_TELEGRAM_BOT_TOKEN="1234567890:replace-with-bot-token"
export ALERTMANAGER_TELEGRAM_CHAT_ID="123456789"

export K3S_CHANNEL="stable"

# S3 backup (Paperless document/export backups and k3s snapshots)
export BACKUP_S3_BUCKET="your-bucket-name"
export AWS_REGION="eu-west-2"

# IAM access key for that bucket. Do not commit real values.
# scripts/k8s.sh secrets -> Kubernetes secret backup-s3-credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) in paperless.
export BACKUP_S3_ACCESS_KEY_ID="your-access-key-id"
export BACKUP_S3_SECRET_ACCESS_KEY="your-secret-access-key"

# Paperless-ngx
export PAPERLESS_DB_PASSWORD="generate-a-long-random-password"
export PAPERLESS_SECRET_KEY="generate-a-long-random-secret-key"
export PAPERLESS_ADMIN_USER="admin"
export PAPERLESS_ADMIN_PASSWORD="generate-a-strong-password"
export PAPERLESS_ADMIN_MAIL="admin@lhowsam.com"
export PAPERLESS_TIME_ZONE="Europe/London"

# n8n
export N8N_DB_PASSWORD="generate-a-long-random-password"
export N8N_ENCRYPTION_KEY="generate-a-long-random-encryption-key"
export N8N_HELM_CHART_VERSION="1.4.3"

# --- Cloudflare Tunnel: Zero Trust install token + scripts/cloudflare-tunnel.sh install-token ---
# export CLOUDFLARE_TUNNEL_TOKEN="eyJ..."
export CLOUDFLARE_TUNNEL_ORIGIN="http://127.0.0.1:80"
